---
const whatsappUrl =
  "https://wa.me/543841453879?text=Hola,%20me%20interesa%20conocer%20más%20sobre%20sus%20servicios";
const instagramUrl = "https://www.instagram.com/empulse.site";
const email = "empulse.dev@gmail.com";

const navLinks = [
  { label: "Home", href: "/#home", num: "01" },
  { label: "Servicios", href: "/#servicios", num: "02" },
  { label: "Proyectos", href: "/#proyectos", num: "03" },
  { label: "Precios", href: "/#precios", num: "04" },
  { label: "Contacto", href: "/contacto", num: "05" },
];
---

<header id="site-header" class="fixed inset-x-0 top-0 z-50">
  <div
    id="header-bar"
    class="gutter flex items-center justify-between py-4 transition-[background-color,backdrop-filter] duration-300 md:py-5"
  >
    <a href="/#home" class="flex items-center gap-2" aria-label="Empulse, ir al inicio">
      <img src="/logo.svg" alt="" width="36" height="36" class="h-8 w-8 md:h-9 md:w-9" />
      <span class="text-xl font-bold tracking-tight text-white md:text-2xl">Empulse</span>
    </a>

    <div class="flex items-center gap-6">
      <a
        href="/contacto"
        class="link-u meta hidden text-white/80 transition-colors duration-200 hover:text-white md:inline-flex"
      >
        Contactanos <span class="arrow-nudge" aria-hidden="true">↗</span>
      </a>

      <button
        id="menu-toggle"
        type="button"
        class="group flex h-11 items-center gap-3 rounded-full pl-2 text-white"
        aria-expanded="false"
        aria-controls="menu-overlay"
        aria-label="Abrir menú"
      >
        <span class="meta hidden sm:inline" data-menu-label>Menú</span>
        <span class="relative block h-3 w-7" aria-hidden="true">
          <span class="menu-bar absolute left-0 top-0 h-[2px] w-full bg-current"></span>
          <span class="menu-bar absolute bottom-0 left-0 h-[2px] w-full bg-current"></span>
        </span>
      </button>
    </div>
  </div>
</header>

<div
  id="menu-overlay"
  class="menu-overlay fixed inset-0 z-[60] flex flex-col bg-ink text-bone"
  role="dialog"
  aria-modal="true"
  aria-label="Menú principal"
  hidden
>
  <div class="gutter flex items-center justify-between py-4 md:py-5">
    <a href="/#home" class="flex items-center gap-2" data-menu-link>
      <img src="/logo.svg" alt="" width="36" height="36" class="h-8 w-8 md:h-9 md:w-9" />
      <span class="text-xl font-bold tracking-tight text-white md:text-2xl">Empulse</span>
    </a>
    <button
      id="menu-close"
      type="button"
      class="meta flex h-11 items-center gap-2 rounded-full px-2 text-white/80 transition-colors hover:text-white"
      aria-label="Cerrar menú"
    >
      Cerrar <span aria-hidden="true" class="text-base leading-none">✕</span>
    </button>
  </div>

  <div class="gutter grid flex-1 content-center gap-10 overflow-y-auto pb-10 lg:grid-cols-[1fr_320px] lg:items-end">
    <nav aria-label="Principal">
      <ul class="border-t hairline">
        {navLinks.map((link) => (
          <li class="border-b hairline">
            <a
              href={link.href}
              data-menu-link
              class="menu-link group flex items-baseline justify-between gap-4 py-3 md:py-4"
            >
              <span class="block overflow-hidden">
                <span
                  data-menu-item
                  class="display-tight block text-[clamp(2.5rem,8vw,6.5rem)] leading-[0.95] transition-colors duration-200 group-hover:text-accent"
                >
                  {link.label}
                </span>
              </span>
              <span class="meta text-white/50 transition-colors duration-200 group-hover:text-accent">{link.num}</span>
            </a>
          </li>
        ))}
      </ul>
    </nav>

    <div data-menu-meta class="grid gap-6 text-sm text-white/70">
      <div>
        <p class="meta mb-2 text-white/45">[ Escribinos ]</p>
        <a href={`mailto:${email}`} class="link-u text-bone">{email}</a>
      </div>
      <div>
        <p class="meta mb-2 text-white/45">[ Redes ]</p>
        <div class="flex flex-wrap gap-x-5 gap-y-2">
          <a href={whatsappUrl} target="_blank" rel="noopener noreferrer" class="link-u text-bone">
            WhatsApp <span class="arrow-nudge" aria-hidden="true">↗</span>
          </a>
          <a href={instagramUrl} target="_blank" rel="noopener noreferrer" class="link-u text-bone">
            Instagram <span class="arrow-nudge" aria-hidden="true">↗</span>
          </a>
        </div>
      </div>
      <div>
        <p class="meta mb-2 text-white/45">[ GMT-3 ]</p>
        <p class="font-mono text-bone tabular" data-clock>--:--</p>
      </div>
    </div>
  </div>
</div>

<style>
  #site-header.is-scrolled #header-bar {
    background-color: rgb(9 9 11 / 0.72);
    backdrop-filter: blur(12px);
    -webkit-backdrop-filter: blur(12px);
  }

  .menu-bar {
    transition: transform 250ms var(--ease-out-strong);
  }

  @media (hover: hover) and (pointer: fine) {
    #menu-toggle:hover .menu-bar:first-child {
      transform: translateX(4px);
    }
    #menu-toggle:hover .menu-bar:last-child {
      transform: translateX(-4px);
    }
  }
</style>
