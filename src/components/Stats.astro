---
/**
 * Hairline key/value list with animated counters (rendered inside About).
 */
const stats = [
  {
    value: 20,
    suffix: "+",
    label: "Proyectos exitosos",
    description: "Soluciones entregadas a medida.",
  },
  {
    value: 15,
    suffix: "+",
    label: "Clientes con mantenimiento",
    description: "Soporte y mejoras continuas.",
  },
  {
    value: 100,
    suffix: "%",
    label: "Proyectos entregados",
    description: "Cumplimos lo que prometemos.",
  },
  {
    value: 1,
    suffix: "+",
    label: "Años de experiencia",
    description: "Desarrollo de sistemas reales.",
  },
];
---

<div id="trayectoria">
  <p class="meta mb-4 text-white/50">(Nuestra trayectoria)</p>
  <dl class="border-t hairline">
    {stats.map((item) => (
      <div data-reveal class="grid grid-cols-[1fr_auto] items-baseline gap-x-6 gap-y-1 border-b hairline py-4 md:grid-cols-[1.2fr_1fr_auto]">
        <dt class="text-base font-semibold text-bone">{item.label}</dt>
        <dd class="order-3 col-span-2 text-sm text-white/55 md:order-none md:col-span-1">{item.description}</dd>
        <dd class="display-tight tabular text-right text-[clamp(2rem,4vw,3.25rem)] leading-none text-bone">
          <span data-counter data-target={item.value}>{item.value}</span><span class="text-accent">{item.suffix}</span>
        </dd>
      </div>
    ))}
  </dl>
</div>
