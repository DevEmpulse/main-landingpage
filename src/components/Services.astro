---
const services = [
  {
    title: "Landing Pages de Alta Conversión",
    description:
      "Estructura orientada a ventas, copy estratégico y llamadas a la acción claras para transformar visitas en consultas.",
    features: ["Propuesta de valor clara", "CTA multiples", "SEO técnico base"],
  },
  {
    title: "Software a Medida",
    description:
      "Sistemas internos y plataformas web pensadas para tu flujo real de trabajo, sin procesos forzados.",
    features: ["Arquitectura escalable", "Integraciones", "Paneles de gestion"],
  },
  {
    title: "Automatizacion de Procesos",
    description:
      "Reducimos tareas repetitivas y errores operativos para que tu equipo dedique tiempo a crecimiento y ventas.",
    features: ["Ahorro de tiempo", "Menos errores", "Más trazabilidad"],
  },
  {
    title: "Soporte y Evolucion",
    description:
      "No solo lanzamos: acompanamos mejoras continuas, monitoreo y soporte para sostener resultados.",
    features: ["Ajustes iterativos", "Soporte tecnico", "Roadmap de mejora"],
  },
];
---

<script type="application/ld+json">
  {JSON.stringify({
    "@context": "https://schema.org",
    "@graph": services.map((s) => ({
      "@type": "Service",
      name: s.title,
      description: s.description,
      provider: {
        "@type": "Organization",
        name: "Empulse",
        url: "https://empulse.site",
      },
      areaServed: { "@type": "Country", name: "Argentina" },
      serviceType: s.title,
      hasOfferCatalog: {
        "@type": "OfferCatalog",
        name: s.title,
        itemListElement: s.features.map((feature) => ({
          "@type": "Offer",
          itemOffered: { "@type": "Service", name: feature },
        })),
      },
    })),
  })}
</script>

<section data-motion-section id="servicios" class="relative overflow-hidden bg-gradient-to-br from-gray-900 via-black to-gray-900 py-20 text-white">
  <div class="pointer-events-none absolute inset-x-0 top-0 h-[2px] bg-gradient-to-r from-rose-500/30 via-teal-400/30 to-amber-300/30"></div>
  <div class="pointer-events-none absolute inset-x-0 bottom-0 h-[2px] bg-gradient-to-r from-amber-300/30 via-teal-400/30 to-rose-500/30"></div>

  <div class="container relative z-10 mx-auto px-4 sm:px-6 lg:px-20">
    <div class="mb-14 max-w-3xl">
      <p class="mb-3 font-jakarta text-xs uppercase tracking-[0.18em] text-pink-300">Servicios</p>
      <h2 class="font-sora text-4xl font-semibold leading-tight sm:text-5xl">
        Diseño y desarrollo con foco en resultado
      </h2>
      <p class="mt-5 font-jakarta text-lg text-gray-300">
        No vendemos plantillas: armamos la solucion exacta para tu negocio, con UX clara, velocidad y conversion.
      </p>
    </div>

    <div class="grid gap-4 md:grid-cols-2">
      {services.map((service) => (
        <article class="rounded-2xl border border-white/10 bg-white/5 p-6 backdrop-blur-sm transition-colors duration-200 hover:border-pink-500/40">
          <h3 class="font-sora text-2xl font-semibold text-white">{service.title}</h3>
          <p class="mt-3 font-jakarta text-gray-300">{service.description}</p>
          <ul class="mt-4 space-y-2 font-jakarta text-sm text-gray-200">
            {service.features.map((feature) => (
              <li class="flex items-center gap-2">
                <span class="h-1.5 w-1.5 rounded-full bg-pink-400"></span>
                {feature}
              </li>
            ))}
          </ul>
        </article>
      ))}
    </div>
  </div>
</section>