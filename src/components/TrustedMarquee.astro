---
const trustedClients = [
  "RAMSER SAS",
  "tuvisatuviaje",
  "alleefrance",
  "SantiagoHome",
];

const stack = [
  { glyph: "◆", name: "React" },
  { glyph: "✦", name: "TypeScript" },
  { glyph: "✳", name: "Astro" },
  { glyph: "◆", name: "Next.js" },
  { glyph: "✦", name: "Tailwind CSS" },
  { glyph: "✳", name: "Supabase" },
  { glyph: "◆", name: "GSAP" },
  { glyph: "✦", name: "IndexedDB" },
];

const rows = [
  {
    label: "Clientes de referencia",
    items: trustedClients.map((name) => ({ glyph: "●", name })),
    duration: "38s",
    direction: "normal",
  },
  {
    label: "Stack tecnológico",
    items: stack,
    duration: "46s",
    direction: "reverse",
  },
];
---

<section class="relative z-20 overflow-hidden border-y hairline bg-ink py-8 text-bone md:py-10">
  <div class="gutter mb-6 flex items-center justify-between meta text-white/50">
    <span><span class="text-accent">◆</span> Confían en Empulse</span>
    <span class="hidden sm:inline">(Clientes & Stack)</span>
  </div>

  <div class="flex flex-col gap-3 md:gap-4">
    {rows.map((row) => (
      <div
        class="marquee marquee--pausable"
        style={`--marquee-duration:${row.duration};--marquee-direction:${row.direction};`}
        aria-label={row.label}
        role="group"
      >
        {[0, 1].map((copy) => (
          <ul class="marquee__track" aria-hidden={copy === 1 ? "true" : undefined}>
            {[...row.items, ...row.items].map((item) => (
              <li class="flex items-center whitespace-nowrap pr-8 text-[clamp(1.5rem,3.4vw,3rem)] font-extrabold tracking-[-0.03em] md:pr-12">
                <span class="mr-8 text-[0.55em] text-accent md:mr-12" aria-hidden="true">{item.glyph}</span>
                {item.name}
              </li>
            ))}
          </ul>
        ))}
      </div>
    ))}
  </div>
</section>
