---
import { getImage } from "astro:assets";
import ProjectsSection from "./ProjectsSection";

import facturacionImage from "../assets/projects/facturacion.webp";
import ramserImage from "../assets/projects/Ramser.webp";
import tuVisaTuViajeImage from "../assets/projects/tuvisatuviaje.webp";
import alleeFranceImage from "../assets/projects/proyecto-allee-france.webp";
import gestionTurnosImage from "../assets/projects/gestiondeturnos.webp";

const rawProjects = [
  {
    title: "Sistema de Facturacion",
    subtitle: "Automatizacion completa",
    description:
      "Sistema integral para cobro de agua, carga de facturas y resumen diario con comisiones automaticas.",
    imageAsset: facturacionImage,
    category: "Automatizacion",
    date: "2025",
    technologies: ["React", "TypeScript", "Tailwind", "IndexedDB"],
    problem: "3 h por dia en planillas manuales",
    solution: "Sistema web a medida + lector de codigos",
    result: "85% menos tiempo operativo",
  },
  {
    title: "Landing Page Ramser S.A.S",
    subtitle: "Presencia digital profesional",
    description:
      "Landing para empresa de sanidad ambiental en el N.E.A., con UX enfocada en conversion.",
    imageAsset: ramserImage,
    category: "Landing Page",
    date: "2024",
    technologies: ["Astro", "JavaScript", "Tailwind CSS"],
    problem: "Sin presencia digital",
    solution: "Landing optimizada + formulario/CTA",
    result: "Leads desde la primera semana",
  },
  {
    title: "Landing Page Tu Visa, tu Viaje",
    subtitle: "Presencia digital profesional",
    description: "Landing para empresa de gestion de visas y seguros de viaje.",
    imageAsset: tuVisaTuViajeImage,
    category: "Landing Page",
    date: "2025",
    technologies: ["Astro", "JavaScript", "Tailwind CSS"],
    problem: "Sin presencia digital",
    solution: "Landing optimizada + formulario/CTA",
    result: "Mejora de consultas organicas",
    liveUrl: "https://www.tuvisa-tuviaje.com/",
  },
  {
    title: "Web Allee France",
    subtitle: "Landing para asesoria migratoria",
    description:
      "Rediseno visual para marca migratoria, enfocado en confianza, claridad de servicios y conversion por WhatsApp.",
    imageAsset: alleeFranceImage,
    category: "Landing Page",
    date: "2026",
    technologies: ["Astro", "Tailwind CSS", "SEO/GEO", "UX Copywriting"],
    problem: "Mensaje disperso en primer scroll",
    solution: "Hero orientado a propuesta de valor + CTA directos",
    result: "Mayor intencion de contacto",
    liveUrl: "https://alleefrance.com/",
  },
  {
    title: "Generador de Turnos",
    subtitle: "Automatizacion completa",
    description: "Sistema de R.R.H.H. para generar y administrar turnos de personal.",
    imageAsset: gestionTurnosImage,
    category: "Automatizacion",
    date: "2025",
    technologies: ["Next", "TypeScript", "Tailwind", "Supabase"],
    problem: "Horas diarias para organizar horarios",
    solution: "Sistema web a medida",
    result: "85% menos tiempo operativo",
  },
] as const;

const sizes =
  "(max-width: 640px) calc(100vw - 2rem), (max-width: 1024px) calc(50vw - 3rem), (max-width: 1440px) calc(33vw - 3.5rem), 360px";

const projects = await Promise.all(
  rawProjects.map(async ({ imageAsset, ...project }) => {
    const optimizedImage = await getImage({
      src: imageAsset,
      widths: [320, 480, 640, 800],
      sizes,
      format: "webp",
      quality: "mid",
    });

    return {
      ...project,
      image: {
        src: optimizedImage.src,
        srcSet: optimizedImage.srcSet.attribute,
        sizes,
        width: Number(optimizedImage.attributes.width),
        height: Number(optimizedImage.attributes.height),
      },
    };
  }),
);

const whatsappUrl =
  "https://wa.me/543841453879?text=Hola,%20me%20interesa%20conocer%20mas%20sobre%20sus%20servicios";
---

<section
  data-motion-section
  id="proyectos"
  class="relative overflow-hidden bg-gradient-to-br from-gray-900 via-black to-gray-900 py-20 text-white"
>
  <div class="pointer-events-none absolute inset-x-0 top-0 h-[2px] bg-gradient-to-r from-rose-500/30 via-teal-400/30 to-amber-300/30"></div>
  <div class="pointer-events-none absolute inset-x-0 bottom-0 h-[2px] bg-gradient-to-r from-amber-300/30 via-teal-400/30 to-rose-500/30"></div>

  <script type="application/ld+json">
    {JSON.stringify({
      "@context": "https://schema.org",
      "@type": "ItemList",
      name: "Proyectos de desarrollo de software y landing pages",
      description:
        "Casos reales de Empulse para conversion, automatizacion y crecimiento digital",
      itemListElement: projects.map((project, index) => ({
        "@type": "ListItem",
        position: index + 1,
        item: {
          "@type": "CreativeWork",
          name: project.title,
          description: project.description,
          creator: {
            "@type": "Organization",
            name: "Empulse",
            url: "https://empulse.site",
          },
          dateCreated: project.date,
          genre: project.category,
          keywords: project.technologies.join(", "),
        },
      })),
    })}
  </script>

  <div class="container relative z-10 mx-auto px-4 sm:px-6 lg:px-20">
    <div class="mb-14 max-w-3xl">
      <p class="mb-3 font-jakarta text-xs uppercase tracking-[0.18em] text-pink-300">
        Casos reales
      </p>
      <h2 class="font-sora text-4xl font-semibold md:text-5xl">
        Proyectos que <span class="text-pink-600">generan impacto</span>
      </h2>
      <p class="mt-4 font-jakarta text-lg text-gray-300">
        Soluciones reales diseñadas para automatizar procesos, mejorar la presencia
        digital y generar mas oportunidades de negocio.
      </p>
    </div>

    <div data-motion-ignore>
      <ProjectsSection client:visible projects={projects} />
    </div>

    <div class="mt-12 text-center" id="projects-cta">
      <a
        href={whatsappUrl}
        target="_blank"
        rel="noopener noreferrer"
        class="inline-flex items-center gap-2 rounded-full bg-pink-600 px-8 py-3 font-semibold text-white transition-transform duration-200 hover:scale-[1.02]"
      >
        DISCUTIR MI PROYECTO <span>↗</span>
      </a>
    </div>
  </div>
</section>
