---
const whatsappUrl =
  "https://wa.me/543841453879?text=Hola,%20quiero%20consultar%20sobre%20sus%20planes";

const plans = [
  {
    id: "web",
    label: "WEB PROFESIONAL",
    price: "245",
    currency: "USD",
    billing: "50% al inicio · 50% al finalizar",
    timeline: "Entrega estimada: 3 semanas",
    features: [
      "Landing page o web institucional",
      "Diseño UX/UI personalizado",
      "SEO básico y velocidad optimizada",
      "Formulario de contacto / CTA",
      "1 mes de soporte incluido",
    ],
    popular: true,
  },
  {
    id: "software",
    label: "SOFTWARE A MEDIDA",
    price: "800",
    currency: "USD",
    billing: "Según alcance · Cuotas disponibles",
    timeline: "Plazos definidos según complejidad",
    features: [
      "Todo lo del plan Web",
      "App web o sistema a medida",
      "Panel de administración",
      "Integración con sistemas existentes",
      "3 meses de soporte incluido",
    ],
    popular: false,
  },
  {
    id: "auto",
    label: "AUTOMATIZACIÓN",
    price: "500",
    currency: "USD",
    billing: "50% al inicio · 50% al finalizar",
    timeline: "Entrega estimada: 3 semanas",
    features: [
      "Diagnóstico IT personalizado",
      "Automatización de 1–3 procesos",
      "Workflows automatizados",
      "Capacitación del equipo",
      "2 meses de soporte incluido",
    ],
    popular: false,
  },
];
---

<section
  id="precios"
  data-motion-section
  class="relative overflow-hidden bg-gradient-to-b from-black via-[#0a0a10] to-black py-24 text-white lg:py-32"
>
  <!-- Ambient glows -->
  <div class="pointer-events-none absolute inset-0">
    <div class="absolute -left-32 top-0 h-96 w-96 rounded-full bg-pink-600/10 blur-[120px]"></div>
    <div class="absolute -right-32 bottom-0 h-96 w-96 rounded-full bg-cyan-500/8 blur-[120px]"></div>
    <div class="absolute left-1/2 top-1/2 h-64 w-64 -translate-x-1/2 -translate-y-1/2 rounded-full bg-pink-500/5 blur-[80px]"></div>
  </div>

  <div class="relative z-10 mx-auto max-w-[1400px] px-4 sm:px-6 lg:px-20">

    <!-- Header -->
    <div class="mb-14">
      <p class="mb-3 font-jakarta text-xs font-bold tracking-[0.18em] text-pink-500 uppercase">
        Planes y Precios
      </p>
      <h2 class="font-sora text-4xl font-bold leading-tight tracking-tight sm:text-5xl lg:text-6xl">
        Inversión <span class="text-pink-500">clara y transparente</span>
      </h2>
      <p class="mt-4 max-w-xl font-jakarta text-base text-gray-400 sm:text-lg">
        Sin sorpresas. Sabés exactamente qué incluye cada solución.
      </p>
    </div>

    <!-- Cards grid -->
    <div class="grid gap-6 md:grid-cols-3 md:items-start">
      {plans.map((plan) => (
        <div
          class:list={[
            "pricing-card group relative flex flex-col rounded-2xl border p-7 transition-all duration-300",
            plan.popular
              ? "border-pink-500/70 bg-[#13111a] shadow-[0_0_40px_rgba(236,72,153,0.12)]"
              : "border-white/8 bg-[#0e0e16] hover:border-white/15",
          ]}
        >
          <!-- Popular badge -->
          {plan.popular && (
            <div class="absolute -top-4 left-1/2 -translate-x-1/2">
              <span class="inline-flex items-center rounded-full bg-pink-600 px-4 py-1.5 font-jakarta text-xs font-bold tracking-widest text-white uppercase shadow-lg">
                Más Popular
              </span>
            </div>
          )}

          <!-- Plan label -->
          <p class="mb-5 font-jakarta text-[10px] font-bold tracking-[0.2em] text-gray-500 uppercase">
            {plan.label}
          </p>

          <!-- Price -->
          <div class="mb-1 flex items-baseline gap-1">
            <span class="font-jakarta text-sm text-gray-400">desde</span>
            <span class="font-sora text-5xl font-bold tracking-tight text-white">
              ${plan.price}
            </span>
            <span class="font-jakarta text-sm font-semibold text-gray-400">{plan.currency}</span>
          </div>
          <p class="font-jakarta text-sm font-medium text-gray-300">{plan.billing}</p>
          <p class="mb-7 mt-1 font-jakarta text-xs text-gray-500">{plan.timeline}</p>

          <!-- Divider -->
          <div class:list={[
            "mb-7 h-px w-full",
            plan.popular ? "bg-pink-500/20" : "bg-white/6",
          ]}></div>

          <!-- Features -->
          <ul class="mb-8 flex flex-1 flex-col gap-3">
            {plan.features.map((feature) => (
              <li class="flex items-start gap-3">
                <span class:list={[
                  "mt-0.5 flex h-4 w-4 shrink-0 items-center justify-center rounded-full text-[10px] font-bold",
                  plan.popular
                    ? "bg-pink-500/20 text-pink-400"
                    : "bg-white/8 text-green-400",
                ]}>
                  ✓
                </span>
                <span class="font-jakarta text-sm leading-relaxed text-gray-300">{feature}</span>
              </li>
            ))}
          </ul>

          <!-- CTA -->
          <a
            href={whatsappUrl}
            target="_blank"
            rel="noopener noreferrer"
            class:list={[
              "inline-flex w-full items-center justify-center rounded-xl px-6 py-3.5 font-jakarta text-sm font-semibold transition-all duration-200",
              plan.popular
                ? "bg-pink-600 text-white hover:bg-pink-500 hover:scale-[1.02] active:scale-[0.98] shadow-[0_4px_24px_rgba(236,72,153,0.35)]"
                : "border border-white/15 text-white hover:bg-white/5 hover:border-white/25",
            ]}
          >
            Consultar →
          </a>
        </div>
      ))}
    </div>

    <!-- Footer note -->
    <p class="mt-3 text-center font-jakarta text-sm text-gray-500">
      ¿Necesitás algo específico?{" "}
      <a
        href={whatsappUrl}
        target="_blank"
        rel="noopener noreferrer"
        class="font-semibold text-pink-500 transition-colors hover:text-pink-400"
      >
        Contanos tu caso →
      </a>
    </p>

  </div>
</section>

<style>
  .pricing-card {
    will-change: transform;
  }
  .pricing-card:not(.popular-card):hover {
    transform: translateY(-2px);
  }
</style>
