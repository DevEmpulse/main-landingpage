---
import SectionIndex from "./SectionIndex.astro";

const whatsappUrl =
  "https://wa.me/543841453879?text=Hola,%20quiero%20consultar%20sobre%20sus%20planes";

const plans = [
  {
    id: "web",
    label: "WEB PROFESIONAL",
    price: "245",
    currency: "USD",
    billing: "50% al inicio · 50% al finalizar",
    timeline: "Entrega estimada: 3 semanas",
    features: [
      "Landing page o web institucional",
      "Diseño UX/UI personalizado",
      "SEO básico y velocidad optimizada",
      "Formulario de contacto / CTA",
      "1 mes de soporte incluido",
    ],
    popular: true,
  },
  {
    id: "software",
    label: "SOFTWARE A MEDIDA",
    price: "800",
    currency: "USD",
    billing: "Según alcance · Cuotas disponibles",
    timeline: "Plazos definidos según complejidad",
    features: [
      "Todo lo del plan Web",
      "App web o sistema a medida",
      "Panel de administración",
      "Integración con sistemas existentes",
      "3 meses de soporte incluido",
    ],
    popular: false,
  },
  {
    id: "auto",
    label: "AUTOMATIZACIÓN",
    price: "500",
    currency: "USD",
    billing: "50% al inicio · 50% al finalizar",
    timeline: "Entrega estimada: 3 semanas",
    features: [
      "Diagnóstico IT personalizado",
      "Automatización de 1–3 procesos",
      "Workflows automatizados",
      "Capacitación del equipo",
      "2 meses de soporte incluido",
    ],
    popular: false,
  },
];
---

<section id="precios" class="relative bg-ink py-20 text-bone md:py-28">
  <div class="gutter">
    <SectionIndex num="04" label="Precios" />

    <div class="mb-12 mt-12 grid gap-6 md:mb-16 md:mt-16 lg:grid-cols-12 lg:items-end">
      <div class="lg:col-span-8">
        <p class="meta mb-4 text-white/50">(Planes y precios)</p>
        <h2 class="text-[clamp(2.25rem,5vw,4.5rem)] font-extrabold leading-[1.02] tracking-[-0.035em]">
          Inversión <span class="text-accent">clara y transparente</span>
        </h2>
      </div>
      <p data-reveal class="max-w-sm text-base leading-relaxed text-white/65 lg:col-span-4 lg:justify-self-end">
        Sin sorpresas. Sabés exactamente qué incluye cada solución.
      </p>
    </div>

    <div class="grid border-t hairline md:grid-cols-3">
      {plans.map((plan, index) => (
        <article
          data-reveal
          class:list={[
            "pricing-card relative flex flex-col border-b hairline py-10 md:border-b-0 md:px-8 md:py-12",
            index > 0 && "md:border-l",
            index === 0 && "md:pl-0",
          ]}
        >
          {plan.popular && (
            <span class="pricing-flag absolute inset-x-0 top-0 h-[3px] bg-accent md:left-0" aria-hidden="true"></span>
          )}

          <div class="meta mb-8 flex items-center justify-between gap-4 text-white/55">
            <span>({String(index + 1).padStart(2, "0")}) {plan.label}</span>
            {plan.popular && (
              <span class="rounded-full bg-accent px-3 py-1 text-white">Más popular</span>
            )}
          </div>

          <p class="meta text-white/50">Desde</p>
          <p class="mt-1 flex items-baseline gap-2">
            <span class="display-tight tabular text-[clamp(3.5rem,6vw,5.5rem)] leading-none text-bone">${plan.price}</span>
            <span class="meta text-white/60">{plan.currency}</span>
          </p>
          <p class="mt-4 text-sm font-medium text-bone/90">{plan.billing}</p>
          <p class="mt-1 text-sm text-white/50">{plan.timeline}</p>

          <ul class="mb-10 mt-8 flex flex-1 flex-col border-t hairline">
            {plan.features.map((feature) => (
              <li class="flex items-start gap-3 border-b hairline py-3 text-sm leading-relaxed text-white/75">
                <span class="mt-[0.2em] text-[0.7em] text-accent" aria-hidden="true">◆</span>
                {feature}
              </li>
            ))}
          </ul>

          <a
            href={whatsappUrl}
            target="_blank"
            rel="noopener noreferrer"
            class:list={["btn-pill w-full", plan.popular ? "btn-accent" : "btn-ghost"]}
          >
            Consultar <span class="arrow-nudge" aria-hidden="true">↗</span>
          </a>
        </article>
      ))}
    </div>

    <p class="mt-10 text-center text-sm text-white/55">
      ¿Necesitás algo específico?{" "}
      <a
        href={whatsappUrl}
        target="_blank"
        rel="noopener noreferrer"
        class="link-u link-u--static font-semibold text-accent"
      >
        Contanos tu caso <span class="arrow-nudge" aria-hidden="true">→</span>
      </a>
    </p>
  </div>
</section>
