---
const whatsappUrl = 'https://wa.me/543841453879?text=Hola,%20me%20gustaría%20obtener%20más%20información%20sobre%20sus%20servicios';
---

<a
  href={whatsappUrl}
  target="_blank"
  rel="noopener noreferrer"
  aria-label="Contactar por WhatsApp"
  class="whatsapp-fab fixed bottom-5 right-5 z-50 rounded-full bg-green-500 p-4 text-white shadow-lg shadow-black/40 sm:bottom-6 sm:right-6"
>
  <img src="/whatsapp-icon.svg" alt="" aria-hidden="true" class="h-6 w-6" loading="eager" decoding="async" />
</a>

<style>
  .whatsapp-fab {
    transition:
      transform 200ms var(--ease-out-strong),
      background-color 200ms ease;
  }

  .whatsapp-fab:active {
    transform: scale(0.95);
  }

  @media (hover: hover) and (pointer: fine) {
    .whatsapp-fab:hover {
      transform: scale(1.06);
      background-color: #16a34a;
    }
  }
</style>
