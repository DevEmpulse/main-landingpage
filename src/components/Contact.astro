---
import SectionIndex from "./SectionIndex.astro";

interface Props {
  indexNum?: string;
  pageUrl?: string;
}

const { indexNum = "05", pageUrl = "https://empulse.site/#contacto" } = Astro.props;
const whatsappUrl = 'https://wa.me/543841453879?text=Hola,%20me%20interesa%20conocer%20mas%20sobre%20sus%20servicios';
const email = 'empulse.dev@gmail.com';

const contactRows = [
  { label: "WhatsApp", value: "+54 3841 453879", href: whatsappUrl, external: true, cta: "Enviar mensaje" },
  { label: "Email", value: email, href: `mailto:${email}`, external: false, cta: "Enviar email" },
  { label: "Ubicación", value: "Trabajamos de forma remota · Atendemos toda Latinoamérica" },
  { label: "Horarios", value: "Lunes a Viernes: 9:00 - 18:00 · Sábados y Domingos: 9:00 - 14:00" },
];

const reasons = [
  "Respuesta en menos de 24 horas",
  "Consultoría gratuita inicial",
  "Presupuesto sin compromiso",
];

const fieldClass =
  "contact-field w-full border-0 border-b border-white/20 bg-transparent px-0 py-3 text-base text-bone placeholder-white/35 transition-colors duration-200 focus:border-accent focus:outline-none focus:ring-0";
const labelClass = "meta mb-1 block text-white/55";
---

<section id="contacto" class="relative bg-ink py-20 text-bone md:py-28">
  <script type="application/ld+json">
    {JSON.stringify({
      "@context": "https://schema.org",
      "@type": "ContactPage",
      "name": "Contacto - Empulse Desarrollo de Software",
      "description": "Contacta con Empulse para desarrollo de software a medida, páginas web profesionales y automatización de procesos en Argentina",
      "url": pageUrl,
      "mainEntity": {
        "@type": "Organization",
        "name": "Empulse",
        "url": "https://empulse.site",
        "contactPoint": [
          {
            "@type": "ContactPoint",
            "telephone": "+54-384-145-3879",
            "contactType": "customer service",
            "availableLanguage": "Spanish",
            "areaServed": "AR",
            "serviceArea": {
              "@type": "Country",
              "name": "Argentina"
            }
          },
          {
            "@type": "ContactPoint",
            "email": "empulse.dev@gmail.com",
            "contactType": "customer service",
            "availableLanguage": "Spanish"
          }
        ],
        "address": {
          "@type": "PostalAddress",
          "addressCountry": "AR",
          "addressRegion": "Argentina"
        },
        "openingHours": "Mo-Fr 09:00-18:00, Sa-Su 09:00-14:00",
        "sameAs": [
          "https://www.instagram.com/empulse.site",
          "https://wa.me/543841453879"
        ]
      }
    })}
  </script>

  <div class="gutter">
    <SectionIndex num={indexNum} label="Contacto" />

    <div class="mt-12 grid gap-14 md:mt-16 lg:grid-cols-12 lg:gap-12">
      <div class="lg:col-span-5">
        <p class="meta mb-4 text-white/50">(Hablemos)</p>
        <h2 class="text-[clamp(2.25rem,4.6vw,4.25rem)] font-extrabold leading-[1.02] tracking-[-0.035em]">
          ¿Listo para transformar tu negocio?
        </h2>
        <p class="mt-5 max-w-md text-base leading-relaxed text-white/65 sm:text-lg">
          Contáctanos y comencemos a trabajar juntos.
        </p>

        <dl class="mt-10 border-t hairline">
          {contactRows.map((row) => (
            <div data-reveal class="grid gap-1 border-b hairline py-4 sm:grid-cols-[110px_1fr] sm:gap-6">
              <dt class="meta pt-0.5 text-white/50">{row.label}</dt>
              <dd class="text-bone">
                <span class="block">{row.value}</span>
                {row.href && (
                  <a
                    href={row.href}
                    target={row.external ? "_blank" : undefined}
                    rel={row.external ? "noopener noreferrer" : undefined}
                    class="link-u mt-1 text-sm font-semibold text-accent"
                  >
                    {row.cta} <span class="arrow-nudge" aria-hidden="true">↗</span>
                  </a>
                )}
              </dd>
            </div>
          ))}
        </dl>

        <div class="mt-10">
          <p class="meta mb-3 text-white/50">(¿Por qué elegirnos?)</p>
          <ul class="grid gap-2">
            {reasons.map((reason) => (
              <li class="flex items-center gap-3 text-sm text-white/75">
                <span class="text-[0.7em] text-accent" aria-hidden="true">◆</span>
                {reason}
              </li>
            ))}
          </ul>
        </div>
      </div>

      <div class="lg:col-span-6 lg:col-start-7">
        <div class="rounded-[1.75rem] border hairline bg-ink-2 p-6 sm:p-10">
          <h3 class="text-2xl font-extrabold tracking-[-0.02em]">Envíanos un mensaje</h3>
          <p class="meta mt-2 text-white/45">Todos los campos con * son obligatorios</p>

          <form id="contact-form" class="mt-8 grid gap-7" data-form-status="idle">
            <input type="hidden" name="_language" value="es" />
            <input type="hidden" name="_subject" value="Nuevo mensaje de contacto desde el sitio web" />
            <div class="grid gap-7 md:grid-cols-2">
              <div>
                <label for="name" class={labelClass}>Nombre *</label>
                <input type="text" id="name" name="name" required autocomplete="name" class={fieldClass} placeholder="Tu nombre completo" />
              </div>
              <div>
                <label for="email" class={labelClass}>Email *</label>
                <input type="email" id="email" name="email" required autocomplete="email" class={fieldClass} placeholder="tu@email.com" />
              </div>
            </div>

            <div>
              <label for="company" class={labelClass}>Empresa</label>
              <input type="text" id="company" name="company" autocomplete="organization" class={fieldClass} placeholder="Nombre de tu empresa" />
            </div>

            <div>
              <label for="service" class={labelClass}>Servicio de interés</label>
              <select id="service" name="service" class={`${fieldClass} cursor-pointer`}>
                <option value="">Selecciona un servicio</option>
                <option value="software">Desarrollo de Software</option>
                <option value="automation">Automatización de Procesos</option>
                <option value="individual">Proyectos Individuales</option>
                <option value="integration">Integración de Sistemas</option>
              </select>
            </div>

            <div>
              <label for="message" class={labelClass}>Mensaje *</label>
              <textarea id="message" name="message" required rows="4" class={`${fieldClass} resize-none`} placeholder="Cuéntanos sobre tu proyecto o necesidades..."></textarea>
            </div>

            <button id="contact-submit" type="submit" class="btn-pill btn-accent w-full cursor-pointer text-base">
              Enviar mensaje
            </button>
            <p id="contact-feedback" class="hidden text-sm text-white/70" role="status" aria-live="polite"></p>
          </form>
        </div>
      </div>
    </div>
  </div>
</section>

<script>
  const contactForm = document.getElementById("contact-form");
  const submitButton = document.getElementById("contact-submit");
  const feedback = document.getElementById("contact-feedback");

  if (contactForm instanceof HTMLFormElement && submitButton instanceof HTMLButtonElement && feedback instanceof HTMLElement) {
    contactForm.addEventListener("submit", async (event) => {
      event.preventDefault();
      const formData = new FormData(contactForm);

      submitButton.disabled = true;
      submitButton.textContent = "Enviando...";
      feedback.classList.add("hidden");

      try {
        const response = await fetch("https://formspree.io/f/manjlrzp", {
          method: "POST",
          body: formData,
          headers: { Accept: "application/json" },
        });

        if (!response.ok) throw new Error("request_failed");

        contactForm.reset();
        feedback.textContent = "Mensaje enviado. Te respondemos en menos de 24 horas.";
      } catch {
        feedback.textContent = "No pudimos enviar el mensaje ahora. Intenta nuevamente.";
      } finally {
        feedback.classList.remove("hidden");
        submitButton.disabled = false;
        submitButton.textContent = "Enviar mensaje";
      }
    });
  }
</script>

<style>
  .contact-field option {
    background-color: #101014;
    color: #f3efe9;
  }

  button:disabled {
    opacity: 0.7;
    cursor: not-allowed;
  }
</style>
