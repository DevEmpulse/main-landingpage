---
const whatsappUrl =
  "https://wa.me/543841453879?text=Hola,%20quiero%20una%20landing%20page%20que%20me%20ayude%20a%20captar%20m%C3%A1s%20clientes";
---

<section
  id="home"
  data-motion-section
  class="relative overflow-hidden bg-gradient-to-br from-gray-900 via-black to-gray-900 text-white hero-full"
>
  <div class="pointer-events-none absolute inset-0">
    <div class="absolute inset-0 hero-dot-bg opacity-35"></div>
    <img
      src="/logo.svg"
      alt="Empulse"
      width="620"
      height="620"
      class="absolute left-1/2 top-1/2 h-[420px] w-[420px] -translate-x-1/2 -translate-y-1/2 opacity-[0.08] sm:h-[620px] sm:w-[620px]"
      loading="eager"
      decoding="async"
    />
    <div class="absolute -top-28 left-0 h-80 w-80 rounded-full bg-pink-500/25 blur-3xl"></div>
    <div class="absolute right-0 top-36 h-72 w-72 rounded-full bg-cyan-400/20 blur-3xl"></div>
    <div class="absolute bottom-0 left-1/3 h-72 w-72 rounded-full bg-amber-300/15 blur-3xl"></div>
  </div>

  <div class="pointer-events-none absolute inset-x-0 top-0 h-[2px] bg-gradient-to-r from-rose-500/30 via-teal-400/30 to-amber-300/30"></div>
  <div class="pointer-events-none absolute inset-x-0 bottom-0 h-[2px] bg-gradient-to-r from-amber-300/30 via-teal-400/30 to-rose-500/30"></div>

  <div class="container relative z-10 mx-auto px-4 pb-20 pt-44 sm:px-6 sm:pt-48 lg:px-20 lg:pt-52">
    <div class="mx-auto max-w-4xl text-center">
      <p class="mb-5 inline-flex rounded-full border border-pink-400/30 bg-pink-500/10 px-4 py-2 text-sm text-pink-200">
        Soluciones IT a medida para negocios que quieren escalar
      </p>

      <h1 class="font-sora text-4xl font-semibold leading-[1.05] tracking-tight sm:text-5xl lg:text-6xl">
        Tu negocio necesita una web que
        <span class="block text-pink-500">convierta visitas en clientes</span>
      </h1>

      <p class="mx-auto mt-6 max-w-2xl font-jakarta text-base leading-relaxed text-gray-300 sm:text-xl">
        Diseñamos landing pages, sistemas y automatizaciones con enfoque comercial real:
        claridad, velocidad y conversion.
      </p>

      <div class="mt-8 flex flex-col items-center justify-center gap-3 sm:flex-row sm:items-center">
        <a
          href={whatsappUrl}
          target="_blank"
          rel="noopener noreferrer"
          class="inline-flex items-center justify-center gap-2 rounded-full bg-pink-600 px-7 py-3 font-jakarta font-semibold text-white transition-transform duration-200 hover:scale-[1.02] active:scale-[0.98]"
        >
          Quiero una landing que venda
          <span>↗</span>
        </a>
        <a
          href="#proyectos"
          class="inline-flex items-center justify-center gap-2 rounded-full border border-white/30 px-7 py-3 font-jakarta font-semibold text-white transition-colors duration-200 hover:bg-white hover:text-black"
        >
          Ver proyectos
        </a>
      </div>
    </div>
  </div>
</section>

<script>
  import "../scripts/gsapHeroIntro";
</script>

<style>
  /*
   * El marquee mide ~68px de alto (py-4 = 32px + texto ~36px).
   * El hero ocupa el resto del viewport: 100svh - 68px.
   * Así el marquee queda completamente visible sin scroll.
   * Fallback 100vh para browsers sin soporte svh.
   */
  .hero-full {
    min-height: calc(100vh - 68px);
    min-height: calc(100svh - 68px);
  }

  .hero-dot-bg {
    background-image: radial-gradient(circle at center, rgba(255, 255, 255, 0.28) 0 1px, transparent 1.3px);
    background-size: 26px 26px;
    mask-image: radial-gradient(circle at center, black 12%, transparent 68%);
  }
</style>