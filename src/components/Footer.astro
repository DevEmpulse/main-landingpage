---
const currentYear = new Date().getFullYear();
const whatsappUrl =
  "https://wa.me/543841453879?text=Hola,%20me%20interesa%20saber%20mas%20sobre%20sus%20servicios";
const instagramUrl = "https://www.instagram.com/empulse.site";
const email = "empulse.dev@gmail.com";

const navLinks = [
  { label: "Home", href: "/#home", num: "01" },
  { label: "Servicios", href: "/#servicios", num: "02" },
  { label: "Proyectos", href: "/#proyectos", num: "03" },
  { label: "Precios", href: "/#precios", num: "04" },
  { label: "Contacto", href: "/contacto", num: "05" },
];

const wordmark = "EMPULSE".split("");
---

<footer class="grain relative overflow-hidden bg-black pt-20 text-bone md:pt-28">
  <div class="gutter relative z-10">
    <div class="grid gap-14 lg:grid-cols-12">
      <div class="lg:col-span-7">
        <p class="meta mb-4 text-white/50">(Trabajemos juntos)</p>
        <a
          href={`mailto:${email}`}
          class="footer-email block break-all text-[clamp(1.75rem,5vw,4.5rem)] font-extrabold leading-[1.02] tracking-[-0.035em] transition-colors duration-200 hover:text-accent sm:break-normal"
        >
          {email}
        </a>
        <p class="mt-5 max-w-md text-base leading-relaxed text-white/60">
          Transformamos negocios con software a medida, automatización y landings enfocadas en conversión.
        </p>
        <div class="mt-8 flex flex-wrap items-center gap-x-8 gap-y-3 font-semibold">
          <a href="/contacto" class="link-u link-u--static text-accent">
            Contactanos <span class="arrow-nudge" aria-hidden="true">↗</span>
          </a>
          <a href={whatsappUrl} target="_blank" rel="noopener noreferrer" class="link-u text-bone">
            WhatsApp <span class="arrow-nudge" aria-hidden="true">↗</span>
          </a>
          <a href={instagramUrl} target="_blank" rel="noopener noreferrer" class="link-u text-bone">
            Instagram <span class="arrow-nudge" aria-hidden="true">↗</span>
          </a>
        </div>
      </div>

      <nav class="lg:col-span-4 lg:col-start-9" aria-label="Pie de página">
        <p class="meta mb-4 text-white/50">(Navegación)</p>
        <ul class="border-t hairline">
          {navLinks.map((link) => (
            <li class="border-b hairline">
              <a
                href={link.href}
                class="group flex items-center justify-between py-3 text-lg font-semibold transition-colors duration-200 hover:text-accent"
              >
                <span class="transition-transform duration-300 ease-out-strong group-hover:translate-x-1.5">{link.label}</span>
                <span class="meta text-white/45 group-hover:text-accent">{link.num}</span>
              </a>
            </li>
          ))}
        </ul>
        <ul class="meta mt-6 grid gap-1.5 text-white/55">
          <li>+54 3841 453879</li>
          <li>Lun - Vie: 9:00 - 18:00</li>
        </ul>
      </nav>
    </div>
  </div>

  <p
    data-footer-wordmark
    class="footer-wordmark display-tight relative z-10 mt-16 select-none whitespace-nowrap text-center text-bone md:mt-24"
    aria-hidden="true"
  >
    {wordmark.map((letter) => (
      <span class="inline-block overflow-hidden align-bottom">
        <span data-footer-letter class="inline-block">{letter}</span>
      </span>
    ))}
  </p>

  <div class="gutter relative z-10 border-t hairline">
    <div class="meta flex flex-col gap-2 py-5 text-white/55 sm:flex-row sm:items-center sm:justify-between">
      <p>&copy; {currentYear} Empulse. Todos los derechos reservados.</p>
      <p class="flex items-center gap-2">
        <span class="inline-block h-1.5 w-1.5 rounded-full bg-accent" aria-hidden="true"></span>
        Argentina <span class="tabular text-bone" data-clock>--:--</span>
      </p>
    </div>
  </div>
</footer>

<style>
  .footer-wordmark {
    font-size: clamp(3.9rem, 19vw, 26rem);
    line-height: 0.78;
    padding-top: 0.04em;
  }
</style>
